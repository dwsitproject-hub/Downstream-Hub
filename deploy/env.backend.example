# Downstream Hub — Backend server (172.28.92.57)
# Copy to /opt/downstream-hub/backend/.env

# ---------- Database (PostgreSQL on dedicated DB server 172.28.92.60) ----------
DATABASE_URL=postgresql://hub:CHANGE_ME_PASSWORD@172.28.92.60:5432/downstream_hub

# ---------- Backend API ----------
NODE_ENV=production
PORT=4000

# ---------- Auth / SSO (CHANGE IN PRODUCTION) ----------
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET
JWT_EXPIRES_IN=1h
SSO_TOKEN_SECRET=CHANGE_ME_SSO_SECRET
SSO_SIGNING_ALG=RS256
SSO_KID=hub-sso-key-1
# SSO_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SSO_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Staging (proxy mode): use the URL browsers actually use (domain or IP) — see Docs/SSO-INTEGRATION-GUIDE.md §12
# SSO_ISSUER=http://172.28.92.56:3010
SSO_ISSUER=http://test-dwshub.kpndomain.com
# Local / direct API only (not for downstream OIDC integrators):
# SSO_ISSUER=http://172.28.92.57:4000
SSO_TOKEN_EXPIRY_SECONDS=60
# OIDC_CODE_TTL_SECONDS=120
# AUTH_SESSION_COOKIE=hub_session
# AUTH_CSRF_COOKIE=hub_csrf
# AUTH_SESSION_TTL_MS=86400000
# OPEN_REGISTRATION=0
# CORS_ORIGINS=http://test-dwshub.kpndomain.com
# PUBLIC_APP_URL=http://test-dwshub.kpndomain.com
# MFA_CHALLENGE_TTL_SECONDS=300
# MFA_MAX_ATTEMPTS=5
# Login MFA magic link (default enabled; set LOGIN_MFA_ENABLED=0 to disable)
# LOGIN_MFA_ENABLED=1
# LOGIN_MAGIC_LINK_TTL_MINUTES=15
# HUB_DEVICE_COOKIE=hub_device
# HUB_DEVICE_TTL_DAYS=90
# RATE_LIMIT_MAGIC_LINK_RESEND_MAX=3
# RATE_LIMIT_MAGIC_LINK_VERIFY_MAX=10
# Public URL of the API (OIDC discovery, authorize, token, JWKS, icon URLs — must match SSO_ISSUER on staging)
# API_PUBLIC_URL=http://172.28.92.56:3010
API_PUBLIC_URL=http://test-dwshub.kpndomain.com
# HTTP staging (not HTTPS): session cookies must not be Secure or browsers drop them
AUTH_COOKIE_SECURE=0
# Direct backend URL (internal only; do not give to downstream app integrators):
# API_PUBLIC_URL=http://172.28.92.57:4000

# Public URL of the Hub SPA (email links: reset, SSO verify)
# PUBLIC_APP_URL=http://172.28.92.56:3010

# ---------- SMTP (optional) ----------
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=
# MAIL_FROM=noreply@example.com
# SMTP_POST_SEND_DELAY_MS=2000
# SMTP_CONNECTION_TIMEOUT_MS=120000
# SMTP_GREETING_TIMEOUT_MS=120000
# SMTP_SOCKET_TIMEOUT_MS=300000

# ---------- Rate limiting & proxy ----------
TRUST_PROXY=1
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_MS=900000

# ---------- Optional: Alibaba Cloud KMS (secrets) ----------
# USE_SECRET_MANAGER=alicloud
# ALICLOUD_SECRET_NAME=downstream-hub/production
# ALICLOUD_REGION=cn-hangzhou

# ---------- Sentinel: AI production support (optional) — see Docs/SENTINEL-GUIDE.md ----------
# Sentinel analyses bug reports/JS errors, writes health reports and answers admins' questions.
# Off unless ANTHROPIC_API_KEY is set. The backend needs outbound HTTPS to api.anthropic.com
# (and api.github.com for code access).
# ANTHROPIC_API_KEY=sk-ant-...
# SENTINEL_GITHUB_TOKEN=github_pat_...        # fine-grained, Contents + Metadata read-only, selected repos
# SENTINEL_MODEL=claude-opus-5-5              # claude-sonnet-5-5 is cheaper
# SENTINEL_AUTO_DAILY_LIMIT=40
# SENTINEL_MANUAL_RUNS_PER_HOUR=60
# SENTINEL_ENABLED=0                          # switch off without removing the key

# ---------- Read-only service API for the MCP Gateway (optional) — see Docs/SENTINEL-GUIDE.md ----------
# Hashes only; create with: node scripts/service-key.js mcp-gateway
# HUB_SERVICE_READ_KEYS=mcp-gateway:<sha256 hex>
# HUB_SERVICE_RATE_PER_MINUTE=120
# HUB_SERVICE_PSEUDONYM_KEY=                  # defaults to JWT_SECRET

# ---------- Sentinel's model follows Milo (optional) — see Docs/SENTINEL-GUIDE.md ----------
# A SEPARATE control key; it may set Sentinel's model and nothing else. Create with:
#   node scripts/service-key.js mcp-gateway --control
# HUB_SERVICE_CONTROL_KEYS=mcp-gateway:<sha256 hex>
# SENTINEL_EFFORT=high                        # low | medium | high | xhigh | max
# SENTINEL_FALLBACKS=off                      # disable server-side refusal fallbacks
